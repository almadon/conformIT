# See templates/.gitignore for the baseline every project copies.
# This repo has no build output or dependency directories of its own to
# add beyond that baseline: it's prose and shell.

# Session logs: docs/documentation-standard.md, "Session logs."
chats/

# Private and internal audit targets: never committed, because naming them in
# a public repository is what docs/security-posture.md rule 9 warns against.
# registry/targets.local.example.yaml is the committed template.
registry/*.local.yaml

# Python bytecode (scripts/lib/py/ is Python now)
__pycache__/
